---
// Páginas seguintes das categorias, no mesmo endereço do WordPress (/categoria-produto/dell/page/2/,
// /categoria-produto/componentes/page/2/).
import CatalogPage from '../../../../components/catalog/CatalogPage.astro';
import { LISTING_KEYS, pagesOf, type ListingKey } from '../../../../data/catalog';

export function getStaticPaths() {
  return LISTING_KEYS.filter((k) => k !== 'servidores').flatMap((categoria) => Array.from({ length: pagesOf(categoria) - 1 }, (_, i) => ({ params: { categoria, page: String(i + 2) } })));
}

const listing = Astro.params.categoria as ListingKey;
const page = Number(Astro.params.page);
---

<CatalogPage listing={listing} page={page} />
