---
import '../styles/global.css';
import '../styles/site.css';
import soraUrl from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { SITE, TRACKING } from '../config/site';
import CookieConsent from '../components/CookieConsent.astro';
import homeSchema from '../data/schema.json';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  /** og:type da página (o All in One SEO usa "website" na home e "article" nas páginas). */
  ogType?: string;
  /** robots da página (ex.: "noindex" no carrinho, como no WordPress); PUBLIC_NOINDEX tem prioridade. */
  robots?: string;
  /** Dados estruturados (JSON-LD) da página; padrão: os da home. Uma lista vira um bloco por item
   *  (como nas páginas de produto do WordPress: o do All in One SEO e o do WooCommerce). */
  schema?: unknown;
  /** Imagem de compartilhamento (padrão: a do site). */
  ogImage?: string;
  /** Datas de publicação e alteração (artigos do blog). */
  article?: { published: string; modified: string; section?: string };
}

const { title = SITE.title, description = SITE.description, canonical = SITE.canonical, ogType = 'website', schema = homeSchema, robots = 'max-image-preview:large', ogImage = SITE.ogImage, article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const noindex = import.meta.env.PUBLIC_NOINDEX === 'true';

const range =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Sora Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url(${soraUrl}) format('woff2-variations');unicode-range:${range}}
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interUrl}) format('woff2-variations');unicode-range:${range}}
@font-face{font-family:'JetBrains Mono Variable';font-style:normal;font-display:swap;font-weight:100 800;src:url(${monoUrl}) format('woff2-variations');unicode-range:${range}}`;

// Rastreamento: com PUBLIC_TRACKING=true, só o dataLayer, o gtag e o estado padrão do consentimento
// (Consent Mode v2, tudo negado) entram no carregamento; as ferramentas carregam depois da escolha da
// pessoa (src/scripts/consent.ts). Sem PUBLIC_TRACKING, nada de rastreamento existe na página.
const consentDefaults = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('consent','default',{ad_storage:'denied',analytics_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',wait_for_update:500});`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Identifica as páginas do site novo (o WordPress publica "WordPress x.y"): usado na verificação do roteamento. */}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : robots} />
    <meta name="theme-color" content="#f5f4f0" />

    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.ogSiteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    {article?.section && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/icon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <link rel="preload" href={soraUrl} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    {TRACKING.enabled && <script is:inline set:html={consentDefaults} />}
    {(Array.isArray(schema) ? schema : [schema]).map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <CookieConsent />
    <script>
      import { initPage } from '../scripts/page';
      initPage();
    </script>
  </body>
</html>
