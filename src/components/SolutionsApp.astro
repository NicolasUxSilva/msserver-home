---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { APP, SOLUTIONS } from '../data/content';
import { APP_STORES } from '../config/site';
import appScreens from '../assets/app/app-telas.png';
import appStore from '../assets/app/app-store.png';
import googlePlay from '../assets/app/google-play.png';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/solutions/*.jpg', { eager: true });
// Imagens originais do acordeão: verticais no desktop e horizontais no celular.
const panels = await Promise.all(
  SOLUTIONS.map(async (s) => {
    const d = files[`../assets/solutions/${s.key}-desktop.jpg`].default;
    const m = files[`../assets/solutions/${s.key}-mobile.jpg`].default;
    const [dImg, mImg] = await Promise.all([getImage({ src: d, width: 640, format: 'webp', quality: 80 }), getImage({ src: m, width: 800, format: 'webp', quality: 80 })]);
    return { ...s, dSrc: dImg.src, mSrc: mImg.src };
  }),
);
---

<section class="band" aria-label="Soluções e aplicativo">
  <div class="container">
    <p class="eyebrow band-eyebrow" data-reveal><b>02</b> Soluções</p>
    <div class="band-grid">
      <div class="acc-wrap">
      <ul class="acc" data-acc data-rail>
        {
          panels.map((p, i) => {
            const Tag = p.href ? 'a' : 'div';
            return (
              <li class="acc-item" style={`--d:url(${p.dSrc});--m:url(${p.mSrc});--reveal-i:${i}`} data-acc-item data-open={i === 0 ? '' : undefined} data-reveal>
                <Tag class="acc-panel" href={p.href ?? undefined} tabindex={p.href ? undefined : 0}>
                  <span class="acc-media" aria-hidden="true" />
                  <span class="acc-shade" aria-hidden="true" />
                  <span class="acc-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="acc-body">
                    {'mobileTitle' in p && p.mobileTitle ? (
                      <h2 class="acc-title">
                        <span class="only-d">{p.title}</span>
                        <span class="only-m">{p.mobileTitle}</span>
                      </h2>
                    ) : (
                      <h2 class="acc-title">{p.title}</h2>
                    )}
                    <span class="acc-text">{p.text}</span>
                    {p.href && (
                      <span class="acc-more" aria-hidden="true">
                        <Icon name="arrow-up-right" size={18} />
                      </span>
                    )}
                  </span>
                </Tag>
              </li>
            );
          })
        }
      </ul>
      <div class="rail-meter acc-meter" aria-hidden="true">
        <span class="rail-count"><b data-rail-pos>01</b> / {String(panels.length).padStart(2, '0')}</span>
        <span class="rail-track"><i data-rail-bar></i></span>
      </div>
      </div>

      {/* Cartão claro: a colagem original do app foi desenhada para fundo branco. */}
      <div class="app" id="appmobile" data-reveal style="--reveal-i:2">
        <Image src={appScreens} alt="" class="app-screens" widths={[480, 960]} sizes="(min-width: 1100px) 600px, 92vw" loading="lazy" />
        <div class="app-copy">
          <h2 class="app-title">
            <span class="app-kicker">{APP.kicker}</span>
            <span>{APP.title}</span>
          </h2>
          <a class="btn btn--primary btn--lg" href={APP.button.href} target="_blank" rel="noopener" data-track="app_click" data-track-location="home-app">
            {APP.button.label}
            <Icon name="arrow-right" class="btn-arrow" />
          </a>
          <div class="stores">
            <a href={APP_STORES.ios} target="_blank" rel="noopener" data-track="app_store_click" data-track-location="ios">
              <Image src={appStore} alt="Baixar na App Store" height={44} densities={[1, 2]} loading="lazy" />
            </a>
            <a href={APP_STORES.android} target="_blank" rel="noopener" data-track="app_store_click" data-track-location="android">
              <Image src={googlePlay} alt="Disponível no Google Play" height={44} densities={[1, 2]} loading="lazy" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Acordeão de imagens: no desktop, o painel sob o mouse ou com foco se expande (como no
  // WordPress). Sem JS, o primeiro painel fica aberto.
  const items = [...document.querySelectorAll<HTMLElement>('[data-acc-item]')];
  const open = (el: HTMLElement) => items.forEach((i) => i.toggleAttribute('data-open', i === el));
  items.forEach((el) => {
    el.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && open(el));
    el.addEventListener('focusin', () => open(el));
  });
</script>

<style>
  .band {
    padding-block: var(--section-y) clamp(3rem, 2rem + 3vw, 5rem);
  }

  /* Sem título próprio na home original, o rótulo da faixa vira uma régua que atravessa a
     composição e ancora acordeão e app numa mesma linha de base. */
  .band-eyebrow {
    display: flex;
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }

  .band-eyebrow::after {
    flex: 1;
    width: auto;
    background: linear-gradient(90deg, currentColor, transparent);
  }

  .band-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 1100px) {
    .band-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 1.25rem;
      align-items: stretch;
    }
  }

  /* ——— Acordeão ——— */
  .acc {
    list-style: none;
    display: flex;
    gap: 0.6rem;
    min-height: 540px;
  }

  .acc-item {
    flex: 1;
    min-width: 0;
    transition: flex-grow 0.7s var(--ease-out);
  }

  .acc-item[data-open] {
    flex-grow: 3.4;
  }

  .acc-panel {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-indigo-900);
    color: var(--c-on-dark);
    text-decoration: none;
    isolation: isolate;
    box-shadow: inset 0 0 0 1px var(--c-line-dark);
  }

  .acc-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    transition: box-shadow var(--dur-2) var(--ease-out);
    pointer-events: none;
  }

  .acc-item[data-open] .acc-panel::after {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.16);
  }

  .acc-panel:focus-visible {
    outline-color: var(--c-orange);
  }

  .acc-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--d) right center / cover no-repeat;
    transform: scale(1.02);
    transition:
      transform 0.9s var(--ease-out),
      background-position 0.7s var(--ease-out),
      background-size 0.7s var(--ease-out),
      filter var(--dur-2) var(--ease-out);
  }

  .acc-item:not([data-open]) .acc-panel:hover .acc-media {
    filter: brightness(1.25);
  }

  /* Aberto: aproxima a fotografia e deixa de fora o rótulo vertical embutido no banner. */
  .acc-item[data-open] .acc-media {
    background-size: 175% auto;
    background-position: 15% 30%;
    transform: scale(1.04);
  }

  .acc-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(14 13 34 / 0.3), rgb(14 13 34 / 0.95) 58%);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  .acc-item[data-open] .acc-shade {
    opacity: 1;
  }

  .acc-index {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--c-line-dark-2);
    border-radius: 6px;
    background: rgb(14 13 34 / 0.5);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--c-on-dark-2);
    transition:
      color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out);
  }

  .acc-item[data-open] .acc-index {
    border-color: rgb(249 131 5 / 0.6);
    color: var(--c-orange);
  }

  .acc-body {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.5s var(--ease-out);
    pointer-events: none;
  }

  .acc-item[data-open] .acc-body {
    opacity: 1;
    transform: none;
    transition-delay: 0.2s;
  }

  .acc-title {
    font-size: clamp(1.4rem, 1.1rem + 0.9vw, 1.85rem);
    color: var(--c-on-dark);
  }

  .acc-text {
    max-width: 46ch;
    color: var(--c-on-dark-2);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .acc-more {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-top: 0.35rem;
    border-radius: 12px;
    background: var(--c-orange);
    color: #1a0f02;
    box-shadow: 0 10px 22px -12px rgb(249 131 5 / 0.8);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .acc-panel:hover .acc-more {
    transform: translate(3px, -3px);
  }

  /* ——— App ——— */
  .app {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    min-height: 540px;
    padding: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    border-radius: var(--r-xl);
    background:
      radial-gradient(90% 70% at 50% 0%, #fff 30%, transparent 75%),
      linear-gradient(180deg, var(--c-surface), var(--c-paper));
    color: var(--c-ink);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.6);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }

  /* Colagem original de telas do app, ao fundo (como na home do WordPress). */
  .app :global(.app-screens) {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: -1;
    width: min(125%, 720px);
    max-width: none;
    transform: translate(-50%, -50%) rotate(-4deg);
    pointer-events: none;
    transition: transform 1.2s var(--ease-out);
  }

  .app:hover :global(.app-screens) {
    transform: translate(-50%, -52%) rotate(-3deg) scale(1.03);
  }

  .app-copy {
    display: grid;
    justify-items: center;
    gap: 1.75rem;
  }

  .app-title {
    display: grid;
    gap: 0.5rem;
    font-size: clamp(2.6rem, 1.6rem + 3.4vw, 4.4rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .app-kicker {
    font-family: var(--f-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-orange-text);
  }

  .stores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .stores a {
    display: block;
    border-radius: 9px;
    box-shadow: 0 8px 18px -12px rgb(0 0 0 / 0.6);
    transition:
      transform var(--dur-1) var(--ease-out),
      box-shadow var(--dur-1) var(--ease-out);
  }

  .stores a:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 24px -12px rgb(0 0 0 / 0.55);
  }

  .stores a:active {
    transform: translateY(0) scale(0.97);
  }

  .stores :global(img) {
    height: 44px;
    width: auto;
  }

  .only-m {
    display: none;
  }

  /* ——— Tablet e celular: painéis empilhados, texto sempre visível ——— */
  @media (max-width: 1099px) {
    .acc {
      flex-direction: column;
      min-height: 0;
      gap: 0.75rem;
    }

    .acc-item,
    .acc-item[data-open] {
      flex: none;
    }

    .acc-panel {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      height: auto;
      background: rgb(255 255 255 / 0.03);
    }

    .acc-media {
      position: relative;
      inset: auto;
      z-index: 0;
      aspect-ratio: 4 / 3;
      background-image: var(--m);
      background-position: center !important;
      background-size: cover !important;
      transform: none !important;
    }

    .acc-shade,
    .acc-index {
      display: none;
    }

    .acc-body {
      position: static;
      opacity: 1;
      transform: none;
      align-content: center;
      gap: 0.5rem;
    }

    .acc-text {
      font-size: 0.9rem;
    }

    .acc-more {
      width: 36px;
      height: 36px;
    }

    .app {
      min-height: 420px;
      margin-top: 0.5rem;
    }
  }

  @media (max-width: 767px) {
    .only-d {
      display: none;
    }

    .only-m {
      display: inline;
    }
  }

  .acc-wrap {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .acc-wrap > .acc {
    flex: 1;
  }

  /* Celular: as três soluções deslizam na horizontal, como a linha de servidores. */
  @media (max-width: 639px) {
    .acc-wrap {
      margin-inline: calc(var(--gutter) * -1);
    }

    .acc {
      flex-direction: row;
      gap: 0.75rem;
      padding: 0 var(--gutter) 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .acc::-webkit-scrollbar {
      display: none;
    }

    .acc-item,
    .acc-item[data-open] {
      flex: 0 0 84%;
      scroll-snap-align: start;
    }

    .acc-panel {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      height: 100%;
    }

    .acc-media {
      aspect-ratio: 16 / 9;
    }

    .acc-body {
      align-content: start;
    }

    .acc-more {
      margin-top: auto;
    }

    .acc-meter {
      display: flex;
    }

    .acc-body {
      padding: 1.1rem 1.15rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .acc-item,
    .acc-media,
    .acc-body,
    .app :global(.app-screens) {
      transition: none;
    }
  }
</style>
