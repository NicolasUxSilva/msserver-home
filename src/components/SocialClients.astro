---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { CLIENTS, CLIENTS_TITLE, SOCIAL_TITLE } from '../data/content';
import { SOCIAL } from '../config/site';

// Logos em versão monocromática (mesmo tratamento da faixa de clientes das landings),
// gerada a partir dos arquivos originais por scripts/client-logos.mjs.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/clients-mono/*.png', { eager: true });
// Dimensiona cada logo pela área (e não só pela altura) para equilibrar o peso visual.
const fit = (w: number, h: number) => {
  const ratio = w / h;
  let width = Math.sqrt(5200 * ratio);
  let height = width / ratio;
  if (height > 60) [height, width] = [60, 60 * ratio];
  if (width > 164) [width, height] = [164, 164 / ratio];
  return { width: Math.round(width), height: Math.round(height) };
};
const logos = CLIENTS.map((c) => {
  const src = files[`../assets/clients-mono/${c.file}.png`].default;
  return { ...c, src, ...fit(src.width, src.height) };
});
---

<section class="social dark-surface on-dark" aria-labelledby="social-title">
  <div class="dark-surface__bg" aria-hidden="true">
    <div class="dark-surface__hatch social-hatch"></div>
    <div class="glow glow--orange social-glow-a"></div>
    <div class="glow glow--indigo social-glow-b"></div>
  </div>
  <div class="container social-inner">
    <h2 id="social-title" data-reveal>{SOCIAL_TITLE}</h2>
    <ul class="social-list">
      {
        SOCIAL.map((s, i) => (
          <li data-reveal style={`--reveal-i:${i + 1}`}>
            <a href={s.url} target="_blank" rel="noopener" data-track="social_click" data-track-location={s.icon}>
              <span class="social-icon">
                <Icon name={s.icon} size={22} />
              </span>
              <span class="social-name">{s.name}</span>
              <Icon name="arrow-up-right" size={18} class="ext-arrow" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="clients" aria-labelledby="clients-title">
  <div class="container clients-inner">
    <h2 id="clients-title" class="clients-title" data-reveal>{CLIENTS_TITLE}</h2>
    <ul class="clients-list">
      {
        logos.map((l, i) => (
          <li data-reveal style={`--reveal-i:${i % 5}`}>
            <Image src={l.src} alt={l.name} width={l.width} height={l.height} densities={[1, 2]} loading="lazy" class="client-logo" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ——— Redes: faixa escura de fechamento, no padrão do CTA final das landings ——— */
  .social {
    padding-block: clamp(4rem, 3rem + 4vw, 7rem);
    overflow: hidden;
  }

  .social-hatch {
    mask-image: radial-gradient(70% 90% at 50% 60%, #000, transparent);
    -webkit-mask-image: radial-gradient(70% 90% at 50% 60%, #000, transparent);
  }

  .social-glow-a {
    left: 20%;
    bottom: -60%;
    width: 60%;
    height: 120%;
  }

  .social-glow-b {
    top: -60%;
    right: -10%;
    width: 50%;
    height: 140%;
  }

  .social-inner {
    display: grid;
    gap: 2.25rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .social-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 4rem;
    }
  }

  .social h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    max-width: 12ch;
  }

  .social-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .social-list a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 72px;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border: 1px solid var(--c-line-dark-2);
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.03);
    color: var(--c-on-dark);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .social-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgb(249 131 5 / 0.12);
    color: var(--c-orange);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .social-name {
    flex: 1;
  }

  .social-list a :global(.ext-arrow) {
    color: var(--c-on-dark-2);
  }

  .social-list a:hover,
  .social-list a:focus-visible {
    border-color: rgb(255 255 255 / 0.4);
    background: rgb(255 255 255 / 0.07);
    transform: translateY(-3px);
  }

  .social-list a:hover .social-icon,
  .social-list a:focus-visible .social-icon {
    background: var(--c-orange);
    color: #1a0f02;
    transform: rotate(-6deg);
  }

  .social-list a:active {
    transform: translateY(-1px) scale(0.98);
  }

  @media (max-width: 419px) {
    .social-list a {
      min-height: 64px;
      gap: 0.6rem;
      padding-right: 0.6rem;
      font-size: 0.92rem;
    }

    .social-icon {
      width: 40px;
      height: 40px;
    }
  }

  /* ——— Clientes (padrão da faixa de logos das landings) ——— */
  .clients {
    padding-block: clamp(4rem, 3rem + 3vw, 6rem) clamp(3.5rem, 2.5rem + 3vw, 5rem);
  }

  .clients-inner {
    display: grid;
    gap: 1.75rem;
  }

  .clients-title {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-3);
  }

  .clients-title::after {
    content: '';
    width: 2.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
    transform-origin: left;
    transition: transform 0.9s var(--ease-out) 0.25s;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .clients-title:not(:global(.is-in))::after {
      transform: scaleX(0);
    }
  }

  .clients-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--c-line);
    border-left: 1px solid var(--c-line);
  }

  .clients-list li {
    display: grid;
    place-items: center;
    min-height: 100px;
    padding: 1rem;
    border-right: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
  }

  @media (max-width: 639px) {
    .clients-list li {
      min-height: 84px;
      padding: 0.75rem;
    }
  }

  .client-logo {
    max-width: 78%;
    height: auto;
    opacity: 0.62;
  }

  @media (min-width: 640px) {
    .clients-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .clients-list li {
      min-height: 120px;
      padding: 1.25rem;
    }

    .client-logo {
      max-width: 100%;
    }
  }
</style>
