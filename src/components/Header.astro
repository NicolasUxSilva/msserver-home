---
import { Image } from 'astro:assets';
import logo from '../assets/brand/msserver-logo.png';
import Icon from './Icon.astro';
import { LINKS, NAV, type NavLink } from '../config/site';

// Itens com submenu: "Servidores" (link + submenu) e "Soluções" (apenas submenu, como no WordPress).
const isCurrent = (href?: string) => href === LINKS.home;

// Camadas do menu móvel: a raiz e uma camada para cada item com submenu (em qualquer nível).
// Em cada camada, os itens que abrem submenu vêm primeiro, lado a lado; os links vêm abaixo.
// Quando o item que abre tem página própria (Servidores, Componentes), o título da camada
// aberta leva a ela.
type MItem = { label: string; href?: string; sub?: string };
type MView = { id: string; title: string; href?: string; parent?: string; openers: MItem[]; links: MItem[] };
const views: MView[] = [];
const addView = (id: string, title: string, items: NavLink[], parent?: string, href?: string) => {
  const view: MView = { id, title, href, parent, openers: [], links: [] };
  views.push(view);
  items.forEach((it, k) => {
    if (it.children) {
      const sub = `${id}-${k}`;
      view.openers.push({ label: it.label, href: it.href, sub });
      addView(sub, it.label, it.children, id, it.href);
    } else {
      view.links.push({ label: it.label, href: it.href });
    }
  });
};
addView('m-v-root', 'Menu', NAV);
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href={LINKS.home} aria-label="MSSERVER, página inicial">
      <Image src={logo} alt="MSSERVER Soluções em Servidores" widths={[160, 320, 480]} sizes="148px" loading="eager" fetchpriority="high" class="brand-logo" />
    </a>

    <nav class="nav-desktop" aria-label="Menu principal">
      <ul class="nav-list">
        {
          NAV.map((item, i) => (
            <li class:list={['nav-item', item.children && 'has-sub']} data-nav-item>
              {item.href ? (
                <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ) : (
                <button class="nav-link nav-link--button" type="button" aria-expanded="false" aria-controls={`sub-${i}`} data-sub-toggle>
                  {item.label}
                  <Icon name="chevron-down" size={16} class="nav-chevron" />
                </button>
              )}
              {item.children && item.href && (
                <button class="nav-caret" type="button" aria-expanded="false" aria-controls={`sub-${i}`} aria-label={`Abrir submenu de ${item.label}`} data-sub-toggle>
                  <Icon name="chevron-down" size={16} class="nav-chevron" />
                </button>
              )}
              {item.children && (
                <div class="nav-panel" id={`sub-${i}`} hidden data-sub-panel>
                  <div class="nav-panel-grid">
                    <ul class="nav-panel-col">
                      {item.children
                        .filter((c) => !c.children)
                        .map((c) => (
                          <li>
                            <a class="nav-panel-link" href={c.href}>
                              {c.label}
                              <Icon name="arrow-right" size={16} class="nav-panel-arrow" />
                            </a>
                          </li>
                        ))}
                    </ul>
                    {item.children
                      .filter((c) => c.children)
                      .map((group) => (
                        <div class="nav-panel-group">
                          {group.href ? (
                            <a class="nav-panel-head" href={group.href}>
                              {group.label}
                              <Icon name="arrow-right" size={14} class="nav-panel-arrow" />
                            </a>
                          ) : (
                            <p class="nav-panel-head">{group.label}</p>
                          )}
                          <ul class:list={['nav-panel-sub', group.children!.length > 4 && 'nav-panel-sub--2col']}>
                            {group.children!.map((c) => (
                              <li>
                                <a href={c.href}>{c.label}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <form class="search" role="search" action={LINKS.search} method="get" data-search>
        <label class="sr-only" for="busca-produtos">Pesquisar produtos</label>
        <Icon name="search" size={18} class="search-icon" />
        <input id="busca-produtos" class="search-input" type="search" name="s" placeholder="Perquisar produtos..." autocomplete="off" />
        <input type="hidden" name="post_type" value="product" />
        <input type="hidden" name="dgwt_wcas" value="1" />
        <button class="search-submit" type="submit" aria-label="Pesquisar"><Icon name="arrow-right" size={18} /></button>
      </form>
      <button class="icon-btn search-toggle" type="button" aria-expanded="false" aria-controls="busca-movel" aria-label="Abrir busca de produtos" data-search-toggle>
        <Icon name="search" size={20} />
      </button>
      <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="menu-movel" aria-label="Abrir menu" data-menu-toggle>
        <span class="menu-toggle-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="busca-movel" class="search-panel" hidden data-search-panel>
    <form class="container search-panel-form" role="search" action={LINKS.search} method="get">
      <label class="sr-only" for="busca-produtos-movel">Pesquisar produtos</label>
      <Icon name="search" size={20} class="search-icon" />
      <input id="busca-produtos-movel" class="search-input" type="search" name="s" placeholder="Perquisar produtos..." autocomplete="off" />
      <input type="hidden" name="post_type" value="product" />
      <input type="hidden" name="dgwt_wcas" value="1" />
      <button class="btn btn--primary btn--sm" type="submit">Pesquisar</button>
    </form>
  </div>

</header>

{/* Menu móvel: painel que desce do topo e cobre metade da tela. Fica fora do <header> de
    propósito: o desfoque do header (backdrop-filter) faria o painel fixo se posicionar dentro
    dele, com altura zero, nos navegadores dos celulares. Submenus abrem em camadas no próprio
    painel, com "Voltar". Mesmos itens, nomes, ordem e destinos do menu do WordPress. */}
<div id="menu-movel" class="m-menu" hidden data-m-menu>
  <div class="m-backdrop" aria-hidden="true" data-m-close></div>
  <div class="m-sheet" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="m-top">
      <a class="m-brand" href={LINKS.home} aria-label="MSSERVER, página inicial">
        <Image src={logo} alt="MSSERVER Soluções em Servidores" widths={[160, 320, 480]} sizes="140px" loading="lazy" class="m-logo" />
      </a>
      <button class="m-close" type="button" aria-label="Fechar menu" data-m-close>
        <Icon name="x" size={22} />
      </button>
    </div>
    <nav class="m-nav" aria-label="Menu">
      {
        views.map((v) => (
          <div class="m-view" id={v.id} data-m-view={v.id} hidden={v.id !== 'm-v-root'} data-dir="none">
            {v.parent && (
              <div class="m-head">
                <button class="m-back" type="button" data-m-back={v.parent}>
                  <Icon name="chevron-left" size={18} />
                  Voltar
                </button>
                {v.href ? (
                  <a class="m-title m-title--link" href={v.href}>
                    {v.title}
                    <Icon name="arrow-right" size={13} />
                  </a>
                ) : (
                  <p class="m-title">{v.title}</p>
                )}
              </div>
            )}
            {v.openers.length > 0 && (
              <div class:list={['m-openers', v.openers.length === 1 && 'm-openers--one']}>
                {v.openers.map((it) => (
                  <button class="m-open" type="button" data-m-open={it.sub}>
                    <span>{it.label}</span>
                    <Icon name="chevron-right" size={16} class="m-chev" />
                  </button>
                ))}
              </div>
            )}
            <ul class="m-grid">
              {v.links.map((it) => (
                <li class="m-cell">
                  <a class="m-link" href={it.href} aria-current={isCurrent(it.href) ? 'page' : undefined}>
                    {it.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(245 244 240 / 0.86);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.25s var(--ease-out),
      background-color 0.25s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  /* Ao rolar, o header ganha borda e uma sombra curta: fica claro que flutua sobre a página. */
  .site-header:global(.is-scrolled) {
    border-bottom-color: var(--c-line);
    background: rgb(245 244 240 / 0.94);
    box-shadow: 0 10px 30px -24px rgb(17 15 40 / 0.45);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: var(--header-h);
  }

  .brand {
    flex: none;
    display: block;
    border-radius: 6px;
    transition: opacity var(--dur-1) var(--ease-out);
  }

  .brand:hover {
    opacity: 0.8;
  }

  .brand-logo {
    width: 148px;
    height: auto;
  }

  /* ——— Navegação desktop ——— */
  .nav-desktop {
    display: none;
    margin-inline: auto;
  }

  .nav-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .nav-item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.7rem;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--c-ink-2);
    font-size: 0.925rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.15s var(--ease-out), background-color 0.15s var(--ease-out);
  }

  /* Traço laranja: indica a página atual e cresce sob o item em hover. */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 2px;
    height: 2px;
    border-radius: 2px;
    background: var(--c-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    opacity: 0.55;
  }

  .has-sub > .nav-link:not(.nav-link--button) {
    padding-right: 0.15rem;
  }

  .nav-link:hover,
  .nav-item.is-open > .nav-link {
    color: var(--c-ink);
  }

  .nav-item.is-open > .nav-link,
  .nav-item.is-open > .nav-caret {
    background: rgb(27 24 32 / 0.05);
  }

  .nav-link[aria-current='page'] {
    color: var(--c-ink);
  }

  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    opacity: 1;
  }

  .nav-caret {
    display: grid;
    place-items: center;
    width: 26px;
    height: 34px;
    margin-left: -2px;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--c-ink-3);
  }

  .nav-caret:hover {
    color: var(--c-ink);
  }

  .nav-link :global(.nav-chevron),
  .nav-caret :global(.nav-chevron) {
    transition: transform 0.2s var(--ease-out);
  }

  [aria-expanded='true'] :global(.nav-chevron) {
    transform: rotate(180deg);
  }

  .nav-panel {
    position: absolute;
    top: calc(100% + 10px);
    left: -0.5rem;
    z-index: 5;
    min-width: 260px;
    padding: 0.6rem;
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    background: var(--c-surface);
    box-shadow: var(--shadow-2);
    transform-origin: top left;
    animation: panel-in 0.24s var(--ease-out);
  }

  /* Seta do painel apontando para o item que o abriu. */
  .nav-panel > .nav-panel-grid::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 1.6rem;
    width: 10px;
    height: 10px;
    border-top: 1px solid var(--c-line);
    border-left: 1px solid var(--c-line);
    background: var(--c-surface);
    transform: rotate(45deg);
  }

  /* Itens entram em cascata curta. */
  @media (prefers-reduced-motion: no-preference) {
    .nav-panel-col li,
    .nav-panel-group {
      animation: item-in 0.35s var(--ease-out) both;
    }

    .nav-panel-col li:nth-child(2) {
      animation-delay: 0.03s;
    }
    .nav-panel-col li:nth-child(3) {
      animation-delay: 0.06s;
    }
    .nav-panel-col li:nth-child(n + 4) {
      animation-delay: 0.09s;
    }
    .nav-panel-group {
      animation-delay: 0.08s;
    }
  }

  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
  }

  /* Ponte invisível para o mouse não perder o hover entre o item e o painel. */
  .nav-panel::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  .nav-panel-grid {
    display: flex;
    gap: 0.5rem;
  }

  .nav-panel-col {
    list-style: none;
    min-width: 200px;
  }

  .nav-panel-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.75rem;
    border-radius: 9px;
    color: var(--c-ink);
    font-size: 0.925rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.15s var(--ease-out),
      padding 0.25s var(--ease-out);
  }

  .nav-panel-link:hover {
    background: var(--c-paper);
    padding-left: 0.95rem;
  }

  .nav-panel :global(.nav-panel-arrow) {
    color: var(--c-ink-3);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s var(--ease-out), transform 0.2s var(--ease-out);
  }

  .nav-panel a:hover :global(.nav-panel-arrow) {
    opacity: 1;
    transform: none;
  }

  .nav-panel-group {
    min-width: 220px;
    padding: 0.85rem 0.95rem 0.95rem;
    border-radius: 11px;
    background: var(--c-paper);
  }

  .nav-panel-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
    font-family: var(--f-mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-orange-text);
    text-decoration: none;
  }

  a.nav-panel-head:hover {
    color: var(--c-ink);
  }

  .nav-panel-sub {
    list-style: none;
    display: grid;
    gap: 0.1rem 1rem;
  }

  .nav-panel-sub--2col {
    grid-template-columns: repeat(2, minmax(0, auto));
  }

  .nav-panel-sub a {
    display: block;
    padding: 0.35rem 0;
    color: var(--c-ink-2);
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-panel-sub a:hover {
    color: var(--c-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ——— Ações: busca e menu ——— */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .search {
    position: relative;
    display: none;
    align-items: center;
  }

  .search :global(.search-icon) {
    position: absolute;
    left: 0.85rem;
    color: var(--c-ink-3);
    pointer-events: none;
  }

  .search-input {
    width: 200px;
    height: 42px;
    padding: 0 2.6rem 0 2.5rem;
    border: 1px solid var(--c-line-2);
    border-radius: 12px;
    background: var(--c-surface);
    font-size: 0.9rem;
    transition: width 0.3s var(--ease-out), border-color 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
  }

  .search-input::placeholder {
    color: var(--c-ink-3);
  }

  .search-input:focus {
    width: 260px;
    outline: none;
    border-color: var(--c-indigo-600);
    box-shadow: 0 0 0 3px rgb(61 58 134 / 0.16);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-submit {
    position: absolute;
    right: 5px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: var(--c-orange);
    color: #1a0f02;
    transition: background-color 0.18s var(--ease-out);
  }

  .search-submit:hover {
    background: var(--c-orange-hover);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--c-line-2);
    border-radius: 12px;
    background: var(--c-surface);
    color: var(--c-ink);
    transition: border-color 0.18s var(--ease-out), background-color 0.18s var(--ease-out);
  }

  .icon-btn:hover {
    border-color: var(--c-ink-3);
  }

  .search-toggle[aria-expanded='true'] {
    border-color: var(--c-ink);
  }

  .search-panel {
    border-top: 1px solid var(--c-line);
    background: var(--c-paper);
    animation: panel-in 0.2s var(--ease-out);
  }

  .search-panel-form {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.85rem;
  }

  .search-panel-form :global(.search-icon) {
    position: absolute;
    left: calc(var(--gutter) + 0.85rem);
    color: var(--c-ink-3);
    pointer-events: none;
  }

  .search-panel-form .search-input,
  .search-panel-form .search-input:focus {
    flex: 1;
    width: auto;
    min-width: 0;
    height: 44px;
    padding-right: 0.85rem;
  }

  .menu-toggle-bars,
  .menu-toggle-bars::before,
  .menu-toggle-bars::after {
    display: block;
    width: 18px;
    height: 1.75px;
    border-radius: 2px;
    background: var(--c-ink);
    transition: transform 0.25s var(--ease-out), opacity 0.2s;
  }

  .menu-toggle-bars {
    position: relative;
  }

  .menu-toggle-bars::before,
  .menu-toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .menu-toggle-bars::before {
    top: -6px;
  }

  .menu-toggle-bars::after {
    top: 6px;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars::before {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle-bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ——— Menu móvel: painel do topo, metade da tela ——— */
  .m-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
  }

  .m-backdrop {
    position: absolute;
    inset: 0;
    background: rgb(14 13 34 / 0.55);
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }

  .m-sheet {
    position: absolute;
    inset: 0 0 auto;
    display: flex;
    flex-direction: column;
    /* Metade da tela; em telas muito baixas (celular deitado, aparelhos pequenos) cresce até o
       mínimo que cabe o menu principal, e o conteúdo rola dentro do painel se precisar. */
    height: max(50svh, min(320px, 100svh));
    border-radius: 0 0 var(--r-xl) var(--r-xl);
    background: var(--c-paper);
    box-shadow: 0 30px 60px -30px rgb(14 13 34 / 0.6);
    overflow: hidden;
    transform: translateY(-100%);
    transition: transform 0.45s var(--ease-out);
  }

  .m-menu:global(.is-open) .m-backdrop {
    opacity: 1;
  }

  .m-menu:global(.is-open) .m-sheet {
    transform: none;
  }

  /* Logo centralizada; o botão de fechar fica no canto direito. */
  .m-top {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    height: var(--header-h);
    border-bottom: 1px solid var(--c-line);
  }

  .m-brand {
    display: block;
    border-radius: 6px;
  }

  .m-brand :global(.m-logo) {
    width: 140px;
    height: auto;
  }

  .m-close {
    position: absolute;
    top: 50%;
    right: var(--gutter);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--c-line-2);
    border-radius: 12px;
    background: var(--c-surface);
    color: var(--c-ink);
    transform: translateY(-50%);
    transition: transform var(--dur-1) var(--ease-out);
  }

  .m-close:active {
    transform: translateY(-50%) scale(0.94);
  }

  .m-nav {
    flex: 1;
    display: grid;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .m-view {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.75rem var(--gutter) 1rem;
  }

  .m-view[hidden] {
    display: none;
  }

  /* Camada que entra: desliza curto no sentido da navegação; ao abrir, os itens sobem em cascata. */
  @media (prefers-reduced-motion: no-preference) {
    .m-view[data-dir='fwd'] {
      animation: view-fwd 0.32s var(--ease-out) both;
    }

    .m-view[data-dir='back'] {
      animation: view-back 0.32s var(--ease-out) both;
