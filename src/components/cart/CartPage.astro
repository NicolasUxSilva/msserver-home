---
// Carrinho (/carrinho/), no sistema visual do catálogo e das páginas de produto. A estrutura (abertura,
// estados, resumo e o modelo de linha) vem daqui; os itens e valores são lidos da Store API do
// WooCommerce no navegador (src/scripts/cart.ts), a mesma sessão de carrinho da finalização de compra.
import '../../styles/catalog-hero.css';
import '../../styles/cart.css';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import WhatsAppFab from '../WhatsAppFab.astro';
import Icon from '../Icon.astro';
import { LINKS, ROUTES, STORE_API, productRoute, whatsappUrl } from '../../config/site';
import { PRODUCTS } from '../../data/catalog';
import { CART, WHATSAPP_ORDER } from '../../data/carrinho';
import schema from '../../data/cart-schema.json';

// Produtos deste site: o item do carrinho (pelo endereço do produto no WooCommerce) leva à página nova
// e usa a mesma foto enquadrada do catálogo.
const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/catalog/*.jpg', { eager: true });
const products = Object.fromEntries(
  await Promise.all(
    Object.values(PRODUCTS).map(async (p) => {
      const src = p.image ? files[`../../assets/catalog/${p.image}`]?.default : null;
      const img = src ? await getImage({ src, widths: [160, 320], format: 'webp', quality: 80 }) : null;
      return [p.url, { path: productRoute(p.slug), image: img?.src ?? null, srcset: img?.srcSet.attribute ?? null }];
    }),
  ),
);

const config = {
  api: STORE_API,
  products,
  routes: { cart: ROUTES.cart, shop: ROUTES.servers, checkout: LINKS.checkout },
  whatsapp: WHATSAPP_ORDER,
  texts: CART,
};
---

<Base title={CART.seoTitle} description="" canonical={CART.canonical} ogType="article" robots={CART.robots} schema={schema}>
  {/* O carrinho não é item do menu: nenhum item marcado. */}
  <Header current={ROUTES.cart} />
  <main id="conteudo" class="cart" data-cart data-state="loading">
    <section class="cat-hero cart-hero dark-surface on-dark" aria-labelledby="carrinho-title">
      <div class="dark-surface__bg" aria-hidden="true">
        <div class="dark-surface__hatch"></div>
        <div class="cat-light"></div>
      </div>
      <div class="container cat-hero-inner">
        <nav class="cat-crumbs" aria-label="Você está em">
          <ol>
            <li><a href={ROUTES.home}>Início</a></li>
            <li><span aria-current="page">{CART.title}</span></li>
          </ol>
        </nav>
        <div class="cat-head">
          <h1 id="carrinho-title" class="cat-title">{CART.title}</h1>
          <p class="cat-sub" data-cart-count hidden></p>
        </div>
      </div>
    </section>

    <section class="cart-body" aria-labelledby="carrinho-title">
      <div class="container">
        <p class="sr-only" aria-live="polite" data-cart-live></p>
        <noscript>
          <div class="cart-card cart-state cart-noscript">
            <h2>{CART.noScriptTitle}</h2>
            <p>{CART.noScriptText}</p>
            <a class="btn btn--dark" href={whatsappUrl()} target="_blank" rel="noopener">{CART.consult}</a>
          </div>
        </noscript>
        <div class="cart-notices" data-cart-notices></div>

        {/* Carregando: o espaço do carrinho já reservado. */}
        <div class="cart-loading" aria-hidden="true">
          <div class="cart-card cart-skeleton">
            <span></span><span></span><span></span>
          </div>
          <div class="cart-card cart-skeleton cart-skeleton--summary">
            <span></span><span></span>
          </div>
          <p class="sr-only">{CART.loading}</p>
        </div>

        {/* Vazio. */}
        <div class="cart-card cart-state cart-empty-state" data-cart-empty>
          <span class="cart-state-icon"><Icon name="shopping-cart" size={30} /></span>
          <h2>{CART.empty}</h2>
          <a class="btn btn--dark" href={ROUTES.servers}>
            {CART.returnToShop}
            <Icon name="arrow-right" class="btn-arrow" />
          </a>
        </div>

        {/* A loja não respondeu (outro domínio, rede, manutenção). */}
        <div class="cart-card cart-state cart-unavailable" data-cart-unavailable>
          <span class="cart-state-icon"><Icon name="cloud-off" size={30} /></span>
          <h2>{CART.unavailableTitle}</h2>
          <p>{CART.unavailableText}</p>
          <div class="cart-state-actions">
            <button class="btn btn--dark" type="button" data-cart-retry>
              <Icon name="rotate-cw" size={18} />
              {CART.retry}
            </button>
            <a class="btn btn--outline" href={whatsappUrl()} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="carrinho">
              <Icon name="whatsapp" size={18} />
              {CART.consult}
            </a>
          </div>
        </div>

        {/* Itens e total. */}
        <div class="cart-grid" data-cart-ready>
          <section class="cart-card cart-list" aria-labelledby="cart-items-title">
            <h2 id="cart-items-title" class="sr-only">Produtos no carrinho</h2>
            <div class="cart-head" aria-hidden="true">
              <span>{CART.columns.product}</span>
              <span>{CART.columns.price}</span>
              <span>{CART.columns.quantity}</span>
              <span>{CART.columns.subtotal}</span>
              <span></span>
            </div>
            <ul class="cart-items" data-cart-items></ul>
            <a class="cart-back" href={ROUTES.servers}>
              <Icon name="arrow-left" size={16} />
              {CART.returnToShop}
            </a>
          </section>

          <aside class="cart-card cart-summary" aria-labelledby="cart-totals-title">
            <h2 id="cart-totals-title" class="cart-summary-title">{CART.totalsTitle}</h2>
            <dl class="cart-totals" data-cart-totals></dl>
            <div class="cart-actions">
              <a class="btn btn--dark cart-checkout" href={ROUTES.checkout} data-track="begin_checkout">
                {CART.checkout}
                <Icon name="arrow-right" class="btn-arrow" />
              </a>
              <a class="btn btn--outline cart-whatsapp" href={whatsappUrl()} target="_blank" rel="noopener" data-cart-whatsapp data-track="cart_whatsapp_click">
                <Icon name="whatsapp" size={18} />
                {CART.whatsapp}
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>

  {/* Modelo de uma linha do carrinho (preenchido pelo navegador). */}
  <template data-cart-row>
    <li class="cart-item">
      <a class="cart-thumb" tabindex="-1" aria-hidden="true"><img alt="" width="96" height="72" loading="lazy" decoding="async" /></a>
      <div class="cart-info">
        <h3 class="cart-name"><a></a></h3>
        <p class="cart-variation"></p>
        <p class="cart-badge"></p>
      </div>
      <p class="cart-price"><span class="cart-label">{CART.columns.price}</span><span data-v></span></p>
      <div class="cart-qty">
        <span class="cart-label" aria-hidden="true">{CART.columns.quantity}</span>
        <div class="cart-qty-field">
          <button type="button" data-step="-1"><Icon name="minus" size={16} /></button>
          <input type="number" min="1" step="1" inputmode="numeric" autocomplete="off" />
          <button type="button" data-step="1"><Icon name="plus" size={16} /></button>
        </div>
      </div>
      <p class="cart-line"><span class="cart-label">{CART.columns.subtotal}</span><span data-v></span></p>
      <button type="button" class="cart-remove"><Icon name="trash-2" size={18} /></button>
    </li>
  </template>

  <Footer />
  <WhatsAppFab />
  <script type="application/json" data-cart-config set:html={JSON.stringify(config)} />
</Base>

<script>
  import { initCart } from '../../scripts/cart';
  initCart();
</script>
