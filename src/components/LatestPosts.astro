---
import { Image } from 'astro:assets';
import data from '../data/posts.json';
import { POSTS_READ_MORE, POSTS_TITLE } from '../data/content';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/posts/*.jpg', { eager: true });
// Data no formato do WordPress ("31 de outubro de 2026"), em português.
const fmt = (iso: string) => new Date(iso).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Sao_Paulo' });
---

<section class="section section--surface posts" id="blog" aria-labelledby="posts-title">
  <div class="container posts-layout">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow"><b>03</b> Blog</p>
        <h2 id="posts-title">{POSTS_TITLE}</h2>
      </div>
    </div>

    <ul class="post-grid" data-rail>
      {
        data.posts.map((p, i) => {
          const img = p.image ? files[`../assets/posts/${p.image}`]?.default : undefined;
          return (
            <li class:list={['post has-card-link', i === 0 && 'post--lead']} data-reveal style={`--reveal-i:${i}`}>
              {/* O cartão inteiro leva ao post (link do título esticado). */}
              <div class="post-thumb" aria-hidden="true">
                {img && <Image src={img} alt="" widths={[400, 640, 900, 1200]} sizes={i === 0 ? '(min-width: 1024px) 680px, 92vw' : '(min-width: 1024px) 240px, (min-width: 720px) 45vw, 92vw'} loading="lazy" />}
              </div>
              <div class="post-body">
                <h3 class="post-title">
                  <a class="card-link" href={p.url}>{p.title}</a>
                </h3>
                <p class="post-excerpt">{p.excerpt}</p>
                <a class="post-more card-raise" href={p.url} aria-label={`${POSTS_READ_MORE.replace(' »', '')}: ${p.title}`}>
                  {POSTS_READ_MORE}
                </a>
              </div>
              <p class="post-meta">
                <time datetime={p.date}>{fmt(p.date)}</time>
                <span>{p.comments}</span>
              </p>
            </li>
          );
        })
      }
    </ul>
    <div class="rail-meter posts-meter" aria-hidden="true">
      <span class="rail-count"><b data-rail-pos>01</b> / {String(data.posts.length).padStart(2, '0')}</span>
      <span class="rail-track"><i data-rail-bar></i></span>
    </div>
  </div>
</section>

<style>
  /* Logo abaixo do vídeo, que avança sobre esta seção: o respiro superior é menor. */
  .posts {
    padding-top: clamp(3.5rem, 2.5rem + 3vw, 6rem);
  }

  .section-head {
    margin-bottom: clamp(2rem, 1.25rem + 2vw, 3rem);
  }

  .section-head h2 {
    max-width: 16ch;
  }

  /* Hierarquia editorial: a postagem mais recente em destaque, as outras duas ao lado. */
  .post-grid {
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 720px) {
    .post-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .post--lead {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: composição editorial. O post em destaque ocupa a coluna da esquerda inteira e o
     título da seção encabeça a coluna dos outros dois (subgrid), sem faixa vazia ao lado. */
  @media (min-width: 1180px) {
    .posts-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      column-gap: 1.25rem;
    }

    .posts-layout > .section-head {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      margin: 0 0 1.75rem;
      padding-left: 0.25rem;
    }

    .post-grid {
      grid-column: 1 / -1;
      grid-row: 1 / -1;
      grid-template-columns: subgrid;
      grid-template-rows: subgrid;
      gap: 1.25rem;
      row-gap: 0;
    }

    .post--lead {
      grid-column: 1;
      grid-row: 1 / -1;
    }

    .post:not(.post--lead):nth-child(2) {
      grid-column: 2;
      grid-row: 2;
      margin-bottom: 1.25rem;
    }

    .post:not(.post--lead):nth-child(3) {
      grid-column: 2;
      grid-row: 3;
    }
  }

  .post {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-paper);
    overflow: hidden;
    cursor: pointer;
    transition:
      border-color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .post:hover {
    border-color: var(--c-line-2);
    background: var(--c-surface);
    box-shadow: var(--shadow-lift);
    transform: translateY(-4px);
  }

  .post:active {
    transform: translateY(-2px);
    transition-duration: 0.08s;
  }

  .post-thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--c-paper-2);
  }

  .post-thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(14 13 34 / 0.18));
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }

  .post:hover .post-thumb::after {
    opacity: 1;
  }

  .post-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  .post:hover .post-thumb :global(img) {
    transform: scale(1.05);
  }

  .post-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    flex: 1;
    padding: 1.4rem 1.5rem 1.25rem;
  }

  .post-title {
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .post--lead .post-title {
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.75rem);
  }

  .post-title a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size var(--dur-2) var(--ease-out);
  }

  .post:hover .post-title a {
    background-size: 100% 1px;
  }

  .post-excerpt {
    color: var(--c-ink-2);
    font-size: 0.95rem;
  }

  .post--lead .post-excerpt {
    max-width: 58ch;
    font-size: 1rem;
  }

  .post-more {
    display: inline-flex;
    align-items: center;
    margin-top: auto;
    padding: 0.35rem 0.1rem 0.15rem;
    color: var(--c-indigo-600);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    letter-spacing: 0;
    transition:
      color var(--dur-1) var(--ease-out),
      letter-spacing var(--dur-2) var(--ease-out);
  }

  .post:hover .post-more,
  .post-more:hover {
    color: var(--c-orange-text);
    letter-spacing: 0.02em;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    padding: 0.85rem 1.5rem;
    border-top: 1px solid var(--c-line);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--c-ink-3);
  }

  .post-meta span::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: 0.9rem;
    border-radius: 50%;
    background: var(--c-line-2);
    vertical-align: middle;
  }

  /* Postagens secundárias: horizontais no desktop, para equilibrar com o destaque. */
  @media (min-width: 1180px) {
    .post:not(.post--lead) {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      grid-template-rows: 1fr auto;
    }

    .post:not(.post--lead) .post-thumb {
      grid-row: 1 / span 2;
      aspect-ratio: auto;
      height: 100%;
    }

    .post:not(.post--lead) .post-body {
      padding: 1.25rem 1.35rem 0.75rem;
      gap: 0.55rem;
    }

    .post:not(.post--lead) .post-excerpt {
      font-size: 0.9rem;
    }

    .post:not(.post--lead) .post-meta {
      padding: 0.7rem 1.35rem;
    }

    /* A foto do destaque cresce para acompanhar a altura da coluna ao lado. */
    .post--lead .post-thumb {
      flex: 1;
      aspect-ratio: auto;
      min-height: 300px;
    }

    .post--lead .post-body {
      flex: none;
    }
  }

  /* Celular: as três postagens deslizam na horizontal (mesmo padrão de servidores e soluções). */
  @media (max-width: 639px) {
    .post-grid {
      grid-auto-flow: column;
      grid-auto-columns: 84%;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .post-grid::-webkit-scrollbar {
      display: none;
    }

    .post {
      scroll-snap-align: start;
    }

    .posts-meter {
      display: flex;
      margin-inline: calc(var(--gutter) * -1);
    }

    .post:hover {
      transform: none;
    }
  }
</style>
