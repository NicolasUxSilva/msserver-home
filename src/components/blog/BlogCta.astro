---
// Faixa final do blog (listagens e artigos): o caminho comercial depois da leitura — pedido de
// orçamento e o WhatsApp do comercial —, na superfície escura do site.
import Icon from '../Icon.astro';
import { ROUTES, whatsappUrl } from '../../config/site';

interface Props {
  /** Lugar do clique (análise). */
  track?: string;
}
const { track = 'blog' } = Astro.props;
---

<section class="blog-cta dark-surface on-dark" aria-labelledby="blog-cta-title">
  <div class="dark-surface__bg" aria-hidden="true">
    <div class="dark-surface__hatch"></div>
    <div class="cat-light"></div>
  </div>
  <div class="container blog-cta-inner">
    <div>
      <p class="eyebrow">Fale com a MSSERVER</p>
      <h2 id="blog-cta-title" class="blog-cta-title">Precisa de ajuda para escolher, ampliar ou manter seus servidores?</h2>
    </div>
    <div class="blog-cta-actions">
      <a class="btn btn--primary btn--lg" href={ROUTES.quote} data-track="cta_click" data-track-location={`${track}-orcamento`}>
        Solicitar orçamento
        <Icon name="arrow-right" class="btn-arrow" />
      </a>
      <a class="btn btn--outline-dark btn--lg" href={whatsappUrl()} target="_blank" rel="noopener" data-track="contact_whatsapp_click" data-track-location={`${track}-cta`}>
        <Icon name="whatsapp" size={20} />
        Falar no WhatsApp
      </a>
    </div>
  </div>
</section>
