---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { SLIDES } from '../data/content';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.jpg', { eager: true });
const img = (name: string) => files[`../assets/hero/${name}.jpg`].default;

// Banners originais do WordPress: versão larga (≥ 768 px) e versão vertical (celular).
const slides = await Promise.all(
  SLIDES.map(async (s, i) => {
    const d = img(`slide-${i + 1}-desktop`);
    const m = img(`slide-${i + 1}-mobile`);
    const [dWebp, mWebp] = await Promise.all([
      getImage({ src: d, widths: [960, 1440, 1920, 2400].filter((w) => w <= d.width), format: 'webp', quality: 78 }),
      getImage({ src: m, widths: [480, 720, 941].filter((w) => w <= m.width), format: 'webp', quality: 78 }),
    ]);
    const fallback = await getImage({ src: d, width: 1440, format: 'jpg', quality: 78 });
    return { ...s, dSet: dWebp.srcSet.attribute, mSet: mWebp.srcSet.attribute, fallback: fallback.src, w: d.width, h: d.height };
  }),
);
---

<section class="hero" id="inicio" aria-roledescription="carrossel" aria-label="Destaques da MSSERVER" data-slider>
  <div class="hero-grid-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="stage-halo" aria-hidden="true"></div>
    <div class="stage on-dark">
      <div class="track" data-slider-track>
        {
          slides.map((s, i) => (
            <article class="slide" id={`slide-${s.key}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} de ${slides.length}`} data-slide data-active={i === 0 ? '' : undefined}>
              <picture class="slide-media">
                <source media="(max-width: 767px)" srcset={s.mSet} sizes="100vw" type="image/webp" />
                <source srcset={s.dSet} sizes="(min-width: 1320px) 1240px, 100vw" type="image/webp" />
                <img src={s.fallback} alt={s.alt} width={s.w} height={s.h} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
              </picture>
              <div class="slide-scrim" aria-hidden="true" />

              {/* Um bloco de texto por slide. Onde o slider do celular do WordPress tinha textos e
                  destinos próprios, as duas versões existem e cada uma aparece no seu tamanho de tela. */}
              <div class="slide-copy">
                {s.desktop.heading === s.mobile.heading ? (
                  i === 0 ? <h1 class="slide-title">{s.desktop.heading}</h1> : <p class="slide-title">{s.desktop.heading}</p>
                ) : (
                  <Fragment>
                    <p class="slide-title only-d">{s.desktop.heading}</p>
                    <p class="slide-title only-m">{s.mobile.heading}</p>
                  </Fragment>
                )}
                <p class="slide-desc only-d">{s.desktop.description}</p>
                <p class="slide-desc only-m">{s.mobile.description}</p>
                <p class="slide-hl only-d">{s.desktop.highlight}</p>
                {s.mobile.highlight && <p class="slide-hl only-m">{s.mobile.highlight}</p>}
                {s.desktop.keywords && <p class="slide-kw only-d">{s.desktop.keywords}</p>}
                {/* Desktop/tablet: o slide inteiro é o link (link "esticado" sobre o banner), como no WordPress. */}
                <a class="btn btn--primary btn--lg slide-btn slide-btn--stretch only-d" href={s.desktop.href} target={s.desktop.newTab ? '_blank' : undefined} rel={s.desktop.newTab ? 'noopener' : undefined} tabindex={i === 0 ? undefined : -1} data-track="hero_click" data-track-location={`slide-${i + 1}`}>
                  {s.desktop.button}
                  <Icon name="arrow-right" class="btn-arrow" />
                </a>
                <a class="btn btn--primary btn--lg slide-btn only-m" href={s.mobile.href} tabindex={i === 0 ? undefined : -1} data-track="hero_click" data-track-location={`slide-${i + 1}-mobile`}>
                  {s.mobile.button}
                  <Icon name="arrow-right" class="btn-arrow" />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      {/* Barra de controle dentro do palco: progresso, slide atual e navegação. */}
      <div class="bar">
        <div class="dots" role="group" aria-label="Escolher slide">
          {
            slides.map((s, i) => (
              <button class="dot" type="button" aria-label={`Ir para o slide ${String(i + 1).padStart(2, '0')} ${s.desktop.heading}`} aria-controls={`slide-${s.key}`} aria-current={i === 0 ? 'true' : undefined} data-slider-dot={i}>
                <span class="dot-bar" aria-hidden="true">
                  <i />
                </span>
                <span class="dot-text" aria-hidden="true">
                  <span class="dot-num">{String(i + 1).padStart(2, '0')}</span>{' '}
                  <span class="dot-label">{s.desktop.heading}</span>
                </span>
              </button>
            ))
          }
        </div>
        <div class="arrows">
          <button class="arrow" type="button" aria-label="Pausar a troca automática" data-slider-pause>
            <Icon name="pause" size={16} class="i-pause" />
            <Icon name="play" size={16} class="i-play" />
          </button>
          <button class="arrow" type="button" aria-label="Slide anterior" data-slider-prev><Icon name="chevron-left" size={18} /></button>
          <button class="arrow" type="button" aria-label="Próximo slide" data-slider-next><Icon name="chevron-right" size={18} /></button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Slider leve: rolagem horizontal nativa com snap (arrastar/deslizar funciona sem JS),
  // troca automática a cada 5 s (como no WordPress), pausada ao interagir, com o mouse sobre
  // o banner, fora da tela ou com redução de movimento.
  const root = document.querySelector<HTMLElement>('[data-slider]');
  const track = root?.querySelector<HTMLElement>('[data-slider-track]');
  if (root && track) {
    const slides = [...track.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-slider-dot]')];
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-slider-pause]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const DELAY = 5000;
    let index = 0;
    let userPaused = reduce.matches;
    let hover = false;
    let visible = true;
    let timer = 0;

    const setActive = (i: number) => {
      index = i;
      slides.forEach((s, j) => {
        const on = j === i;
        s.toggleAttribute('data-active', on);
        s.querySelectorAll<HTMLElement>('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
        s.setAttribute('aria-hidden', String(!on));
      });
      dots.forEach((d, j) => (j === i ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };

    const go = (i: number) => {
      const n = (i + slides.length) % slides.length;
      track.scrollTo({ left: n * track.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
      setActive(n);
      schedule();
    };

    const running = () => !userPaused && !hover && visible;
    const schedule = () => {
      clearTimeout(timer);
      root.classList.toggle('is-playing', running());
      // Reinicia a animação da barra de progresso do slide atual.
      root.classList.remove('tick');
      void root.offsetWidth;
      root.classList.add('tick');
      if (running()) timer = window.setTimeout(() => go(index + 1), DELAY);
    };

    const syncPause = () => {
      pauseBtn.setAttribute('aria-label', userPaused ? 'Retomar a troca automática' : 'Pausar a troca automática');
      pauseBtn.classList.toggle('is-paused', userPaused);
    };

    let scrollTimer = 0;
    track.addEventListener(
      'scroll',
      () => {
        clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          const n = Math.round(track.scrollLeft / track.clientWidth);
          if (n !== index) {
            setActive(n);
            schedule();
          }
        }, 90);
      },
      { passive: true },
    );

    root.querySelector('[data-slider-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-slider-next]')?.addEventListener('click', () => go(index + 1));
    dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
    pauseBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      syncPause();
      schedule();
    });
    const stage = root.querySelector<HTMLElement>('.stage')!;
    stage.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') {
        hover = true;
        schedule();
      }
    });
    stage.addEventListener('pointerleave', () => {
      hover = false;
      schedule();
    });
    root.addEventListener('focusin', () => {
      hover = true;
      schedule();
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) {
        hover = false;
        schedule();
      }
    });
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(index + 1);
      if (e.key === 'ArrowLeft') go(index - 1);
    });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      schedule();
    }).observe(root);
    addEventListener('resize', () => track.scrollTo({ left: index * track.clientWidth }));

    setActive(0);
    syncPause();
    schedule();
  }
</script>


<style>
  .hero {
    position: relative;
    padding-top: clamp(1.25rem, 0.5rem + 2vw, 2.25rem);
    overflow-x: clip;
    view-timeline: --hero block;
  }

  /* Grade técnica das landings: nasce atrás do palco e se dissolve sobre a seção seguinte,
     costurando o hero à linha de servidores. */
  .hero-grid-bg {
    position: absolute;
    inset: 0 0 -320px;
    background-image:
      linear-gradient(to right, rgb(27 24 32 / 0.055) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(27 24 32 / 0.055) 1px, transparent 1px);
    background-size: 56px 56px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 75% 60% at 50% 45%, #000 25%, transparent 72%);
    -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 45%, #000 25%, transparent 72%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
  }

  /* Halo sob o palco: dá profundidade e liga o banner escuro ao fundo claro. */
  .stage-halo {
    position: absolute;
    inset: 12% 4% -8%;
    background:
      radial-gradient(50% 60% at 25% 60%, rgb(61 58 134 / 0.35), transparent 70%),
      radial-gradient(40% 50% at 80% 80%, rgb(249 131 5 / 0.18), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }

  .stage {
    position: relative;
    border-radius: var(--r-xl);
    background: var(--c-indigo-950);
    box-shadow:
      0 0 0 1px rgb(14 13 34 / 0.06),
      var(--shadow-2);
    overflow: hidden;
    isolation: isolate;
  }

  /* Fio de luz na borda interna, como no console das landings. */
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
    pointer-events: none;
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    position: relative;
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    aspect-ratio: 1713 / 918;
    min-height: 480px;
    /* Deixa a próxima seção despontar na primeira dobra: sinal de continuidade. */
    max-height: calc(100svh - var(--header-h) - 10rem);
    width: 100%;
    color: var(--c-on-dark);
    overflow: hidden;
  }

  .slide-media,
  .slide-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .slide-media img {
    object-fit: cover;
    object-position: left center;
    transform: scale(1.05);
    transition: transform 6s var(--ease-out);
  }

  .slide[data-active] .slide-media img {
    transform: scale(1);
  }

  /* Escurece só o lado do texto e a base (onde fica a barra); a arte do banner fica intacta. */
  .slide-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 38%, rgb(14 13 34 / 0.55) 62%, rgb(14 13 34 / 0.8) 100%),
      linear-gradient(0deg, rgb(14 13 34 / 0.7), transparent 22%);
  }

  .slide-copy {
    position: absolute;
    inset: 0;
    --pad: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
    --copy-w: min(46%, 560px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1rem;
    padding: var(--pad) var(--pad) calc(var(--pad) + 3.5rem);
    padding-left: calc(100% - var(--copy-w) + var(--pad));
  }

  .only-m {
    display: none;
  }

  .slide-copy .slide-title,
  .slide-copy .slide-desc,
  .slide-copy .slide-hl,
  .slide-copy .slide-kw {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  /* O botão cobre o banner inteiro: clicar em qualquer ponto leva ao destino do slide. */
  .slide-btn--stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r-xl);
  }

  .slide-copy > * {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.6s var(--ease-out),
      transform 0.7s var(--ease-out);
  }

  .slide[data-active] .slide-copy > * {
    opacity: 1;
    transform: none;
  }

  .slide[data-active] .slide-copy > :nth-child(2) {
    transition-delay: 0.08s;
  }
  .slide[data-active] .slide-copy > :nth-child(3) {
    transition-delay: 0.16s;
  }
  .slide[data-active] .slide-copy > :nth-child(n + 4) {
    transition-delay: 0.24s;
  }

  .slide-title {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(1.9rem, 1rem + 2.4vw, 3.15rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .slide-desc {
    max-width: 44ch;
    color: var(--c-on-dark-2);
    font-size: var(--t-lead);
    line-height: 1.55;
  }

  .slide-hl {
    max-width: 40ch;
    padding-left: 0.85rem;
    border-left: 2px solid var(--c-orange);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.45;
  }

  .slide-kw {
    color: var(--c-on-dark-3);
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .slide-btn {
    position: static;
    margin-top: 0.75rem;
  }

  /* Com o mouse sobre o banner, o CTA reage: o banner inteiro é o link. */
  .slide:hover .slide-btn--stretch {
    background: var(--c-orange-hover);
  }

  .slide:hover .slide-btn--stretch :global(.btn-arrow) {
    transform: translateX(3px);
  }

  /* ——— Barra de controle ——— */
  .bar {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding: 0 clamp(1.25rem, 0.8rem + 1.6vw, 2.25rem) clamp(1rem, 0.7rem + 0.8vw, 1.5rem);
    pointer-events: none;
  }

  .bar > * {
    pointer-events: auto;
  }

  .dots {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 760px;
  }

  .dot {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.5rem 0 0.25rem;
    border: 0;
    background: none;
    color: var(--c-on-dark-3);
    text-align: left;
    transition: color var(--dur-1) var(--ease-out);
  }

  .dot:hover {
    color: var(--c-on-dark-2);
  }

  .dot[aria-current] {
    color: var(--c-on-dark);
  }

  .dot-text {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    min-width: 0;
  }

  .dot-num {
    flex: none;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }

  .dot[aria-current] .dot-num {
    color: var(--c-orange);
  }

  .dot-label {
    overflow: hidden;
    font-size: 0.82rem;
    font-weight: 500;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .dot-bar {
    position: relative;
    height: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.18);
    overflow: hidden;
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .dot:hover .dot-bar {
    background: rgb(255 255 255 / 0.32);
  }

  .dot-bar i {
    position: absolute;
    inset: 0;
    background: var(--c-orange);
    transform: scaleX(0);
    transform-origin: left;
  }

  .dot[aria-current] .dot-bar i {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.is-playing.tick) .dot[aria-current] .dot-bar i {
      animation: progress 5s linear both;
    }
  }

  @keyframes progress {
    from {
      transform: scaleX(0);
    }
  }

  .arrows {
    display: flex;
    gap: 0.4rem;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--c-line-dark-2);
    border-radius: 12px;
    background: rgb(14 13 34 / 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--c-on-dark);
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }

  .arrow:hover {
    border-color: rgb(255 255 255 / 0.45);
    background: rgb(255 255 255 / 0.12);
    transform: translateY(-1px);
  }

  .arrow:active {
    transform: scale(0.94);
  }

  .arrow:focus-visible,
  .dot:focus-visible {
    outline-color: var(--c-orange);
  }

  .arrow :global(.i-play),
  .arrow:global(.is-paused) :global(.i-pause) {
    display: none;
  }

  .arrow:global(.is-paused) :global(.i-play) {
    display: block;
  }

  /* ——— Profundidade ao rolar (animação ligada ao scroll, sem JS) ———
     O palco recua levemente e a imagem se desloca mais devagar que a página. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .stage {
        animation: stage-depth linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }

      .slide-media {
        animation: media-drift linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }

      .stage-halo {
        animation: halo-fade linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 80%;
      }
    }
  }

  @keyframes stage-depth {
    to {
      transform: translateY(6%) scale(0.955);
    }
  }

  @keyframes media-drift {
    to {
      transform: translateY(9%);
    }
  }

  @keyframes halo-fade {
    to {
      opacity: 0;
    }
  }

  @media (max-width: 1023px) {
    .slide-copy {
      --copy-w: min(56%, 520px);
    }

    .slide-scrim {
      background:
        linear-gradient(90deg, transparent 28%, rgb(14 13 34 / 0.72) 50%, rgb(14 13 34 / 0.88) 100%),
        linear-gradient(0deg, rgb(14 13 34 / 0.7), transparent 22%);
    }

    .slide-desc {
      font-size: 1rem;
    }

    .slide-kw {
      display: none;
    }

    .dot-label {
      display: none;
    }
  }

  /* ——— Celular: banner vertical, texto no topo ——— */
  @media (max-width: 767px) {
    .hero {
      padding-top: 0.75rem;
    }

    .stage {
      border-radius: var(--r-lg);
    }

    .slide {
      aspect-ratio: 941 / 1671;
      min-height: 0;
      max-height: 84svh;
    }

    .slide-media img {
      object-position: center bottom;
    }

    .slide-scrim {
      background:
        linear-gradient(180deg, rgb(14 13 34 / 0.6) 0%, rgb(14 13 34 / 0.25) 45%, transparent 62%),
        linear-gradient(0deg, rgb(14 13 34 / 0.75), transparent 18%);
    }

    .only-d {
      display: none;
    }

    .only-m {
      display: block;
    }

    a.only-m {
      display: inline-flex;
    }

    .slide-copy {
      inset: 0 0 auto;
      justify-content: flex-start;
      gap: 0.75rem;
      padding: clamp(4.25rem, 3rem + 5vw, 5.25rem) 1.25rem 1.5rem;
    }

    .slide-title {
      font-size: clamp(1.65rem, 1.1rem + 3vw, 2.2rem);
    }

    .slide-desc {
      font-size: 0.98rem;
    }

    .slide-hl {
      font-size: 0.92rem;
    }

    .slide-btn {
      margin-top: 0.25rem;
    }

    .bar {
      gap: 1rem;
      padding: 0 0.9rem 0.9rem;
    }

    .dots {
      gap: 0.4rem;
    }

    .dot-num {
      font-size: 0.65rem;
    }

    .arrow {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-media img,
    .slide-copy > * {
      transition: none;
      transform: none;
    }
  }
</style>
