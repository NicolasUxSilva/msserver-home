---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { SLIDES } from '../data/content';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/hero/*.jpg', { eager: true });
const img = (name: string) => files[`../assets/hero/${name}.jpg`].default;

// Banners originais do WordPress: versão larga (paisagem) e versão vertical (celular e tablet em pé).
const themes = await Promise.all(
  SLIDES.map(async (s, i) => {
    const d = img(`slide-${i + 1}-desktop`);
    const m = img(`slide-${i + 1}-mobile`);
    const [dWebp, mWebp, fallback] = await Promise.all([
      getImage({ src: d, widths: [960, 1440, 1713].filter((w) => w <= d.width), format: 'webp', quality: 80 }),
      getImage({ src: m, widths: [480, 720, 941].filter((w) => w <= m.width), format: 'webp', quality: 80 }),
      getImage({ src: d, width: 1440, format: 'jpg', quality: 80 }),
    ]);
    return { ...s, dSet: dWebp.srcSet.attribute, mSet: mWebp.srcSet.attribute, fallback: fallback.src, w: d.width, h: d.height };
  }),
);

// Mesmo ponto em que o texto passa para o topo (ver CSS): celular e tablet em pé.
const PORTRAIT = '(max-width: 767px), (max-width: 1023px) and (orientation: portrait)';
---

{/* Hero de fundo inteiro: a arte de cada banner cobre a seção e o texto fica por cima.
    Os três temas se alternam sozinhos, com esmaecimento lento, sem trilho de slides. */}
<section class="hero on-dark" id="inicio" aria-label="Destaques da MSSERVER" data-hero data-theme={themes[0].key}>
  <div class="hero-media" data-hero-visual>
    {
      themes.map((t, i) => (
        // A arte leva ao destino do tema no desktop (no WordPress o banner inteiro era um link).
        <a class="media-item" href={t.desktop.href} target={t.desktop.newTab ? '_blank' : undefined} rel={t.desktop.newTab ? 'noopener' : undefined} tabindex="-1" aria-hidden="true" data-hero-art data-active={i === 0 ? '' : undefined} data-track="hero_click" data-track-location={`hero-${t.key}-arte`}>
          <picture>
            <source media={PORTRAIT} srcset={t.mSet} sizes="100vw" type="image/webp" />
            <source srcset={t.dSet} sizes="100vw" type="image/webp" />
            {/* As três artes carregam logo (as duas seguintes com prioridade baixa), para a troca não esperar a rede. */}
            <img src={t.fallback} alt={t.alt} width={t.w} height={t.h} loading="eager" fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
          </picture>
        </a>
      ))
    }
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-inner">
    {/* Todas as mensagens ocupam a mesma célula da grade: a área tem a altura da maior e a
        troca não empurra nada (sem deslocamento de layout). */}
    <div class="hero-panels">
      {
        themes.map((t, i) => (
          <div class="hero-panel" role="tabpanel" id={`hero-p-${t.key}`} aria-labelledby={`hero-t-${t.key}`} data-hero-panel data-active={i === 0 ? '' : undefined}>
            {t.desktop.heading === t.mobile.heading ? (
              i === 0 ? <h1 class="hero-title">{t.desktop.heading}</h1> : <p class="hero-title">{t.desktop.heading}</p>
            ) : (
              <Fragment>
                <p class="hero-title only-d">{t.desktop.heading}</p>
                <p class="hero-title only-m">{t.mobile.heading}</p>
              </Fragment>
            )}
            <p class="hero-desc only-d">{t.desktop.description}</p>
            <p class="hero-desc only-m">{t.mobile.description}</p>
            <p class="hero-hl only-d">{t.desktop.highlight}</p>
            {t.mobile.highlight && <p class="hero-hl only-m">{t.mobile.highlight}</p>}
            {t.desktop.keywords && <p class="hero-kw only-d">{t.desktop.keywords}</p>}
            <div class="hero-actions">
              <a class="btn btn--primary btn--lg only-d" href={t.desktop.href} target={t.desktop.newTab ? '_blank' : undefined} rel={t.desktop.newTab ? 'noopener' : undefined} data-track="hero_click" data-track-location={`hero-${t.key}`}>
                {t.desktop.button}
                <Icon name="arrow-right" class="btn-arrow" />
              </a>
              <a class="btn btn--primary btn--lg only-m" href={t.mobile.href} data-track="hero_click" data-track-location={`hero-${t.key}-mobile`}>
                {t.mobile.button}
                <Icon name="arrow-right" class="btn-arrow" />
              </a>
            </div>
          </div>
        ))
      }
    </div>

    {/* Índice da seção: as três áreas da MSSERVER. A linha do tema ativo marca o tempo até o próximo. */}
    <div class="hero-index" role="tablist" aria-label="Destaques da MSSERVER" data-hero-tabs>
      {
        themes.map((t, i) => (
          <button class="hero-tab" type="button" role="tab" id={`hero-t-${t.key}`} aria-controls={`hero-p-${t.key}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-hero-tab>
            <span class="tab-line" aria-hidden="true">
              <i />
            </span>
            <span class="tab-label">{t.label}</span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Troca automática dos temas a cada 7 s. Pausa enquanto o mouse ou o foco estão na hero e
  // quando ela sai da tela; não roda com redução de movimento. Escolher um tema reinicia o tempo.
  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-hero-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-hero-panel]')];
    const arts = [...root.querySelectorAll<HTMLElement>('[data-hero-art]')];
    const media = root.querySelector<HTMLElement>('[data-hero-visual]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const fine = matchMedia('(hover: hover) and (pointer: fine)');
    const DELAY = 7000;
    let index = 0;
    let holding = false;
    let visible = true;
    let timer = 0;

    const running = () => !reduce.matches && !holding && visible;
    const schedule = () => {
      clearTimeout(timer);
      root.classList.toggle('is-playing', running());
      // Reinicia a linha de tempo do tema ativo.
      root.classList.remove('tick');
      void root.offsetWidth;
      root.classList.add('tick');
      if (running()) timer = window.setTimeout(() => select(index + 1), DELAY);
    };

    const select = (i: number, focus = false) => {
      index = (i + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        const on = j === index;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[j].toggleAttribute('data-active', on);
        arts[j].toggleAttribute('data-active', on);
      });
      root.dataset.theme = tabs[index].id.replace('hero-t-', '');
      if (focus) tabs[index].focus();
      schedule();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 };
        if (e.key in map) {
          e.preventDefault();
          select(map[e.key], true);
        }
      });
    });

    root.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') {
        holding = true;
        schedule();
      }
    });
    root.addEventListener('pointerleave', () => {
      holding = false;
      schedule();
    });
    root.addEventListener('focusin', () => {
      holding = true;
      schedule();
    });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) {
        holding = false;
        schedule();
      }
    });
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      schedule();
    }).observe(root);

    // Profundidade com o mouse: o fundo se desloca levemente no sentido oposto ao cursor.
    let raf = 0;
    root.addEventListener('pointermove', (e) => {
      if (!fine.matches || reduce.matches || raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const r = root.getBoundingClientRect();
        media.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
        media.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
      });
    });
    root.addEventListener('pointerleave', () => {
      media.style.setProperty('--mx', '0');
      media.style.setProperty('--my', '0');
    });

    // Celular: deslizar o dedo na horizontal troca o tema.
    let x0 = 0;
    let y0 = 0;
    root.addEventListener('touchstart', (e) => ((x0 = e.touches[0].clientX), (y0 = e.touches[0].clientY)), { passive: true });
    root.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) select(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );

    root.classList.add('is-ready');
    select(0);
  }
</script>

<style>
  /* ——— Seção ——— */
  .hero {
    position: relative;
    display: flex;
    /* Proporção natural dos banners (1713 × 918), limitada à altura útil da tela: a arte não é
       cortada nas laterais e a seção seguinte desponta na primeira dobra. */
    height: clamp(520px, 53.5vw, calc(100svh - var(--header-h) - 3rem));
    background: var(--c-indigo-950);
    color: var(--c-on-dark);
    overflow: hidden;
    isolation: isolate;
    view-timeline: --hero block;
  }

  /* ——— Fundo: as artes dos banners ——— */
  .hero-media {
    --mx: 0;
    --my: 0;
    position: absolute;
    inset: -14px;
    z-index: -2;
    transform: translate(calc(var(--mx) * -10px), calc(var(--my) * -8px));
    transition: transform 0.8s var(--ease-out);
  }

  /* Esmaecimento lento entre os temas: a arte nova aparece por cima e a anterior só é escondida
     depois de coberta. Nada desliza. */
  .media-item {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0s linear 1.3s,
      visibility 0s linear 1.3s;
  }

  .media-item[data-active] {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 1.2s var(--ease-out),
      visibility 0s;
  }

  .media-item picture {
    display: block;
    height: 100%;
  }

  .media-item img {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: left center;
  }

  /* Aproximação muito lenta enquanto o tema está ativo: a seção não fica estática. */
  @media (prefers-reduced-motion: no-preference) {
    .media-item[data-active] img {
      animation: settle 9s var(--ease-out) both;
    }
  }

  @keyframes settle {
    from {
      transform: scale(1.07);
    }
  }

  /* Escurece só onde há texto (direita) e onde fica o índice (base). A arte, à esquerda, fica intacta. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, transparent 38%, rgb(14 13 34 / 0.5) 54%, rgb(14 13 34 / 0.8) 100%),
      linear-gradient(0deg, rgb(14 13 34 / 0.85), rgb(14 13 34 / 0.35) 14%, transparent 30%);
    pointer-events: none;
  }

  /* ——— Conteúdo ——— */
  .hero-inner {
    display: flex;
    flex-direction: column;
    width: 100%;
    /* O conteúdo não captura cliques fora dos textos e botões: clicar na arte leva ao destino. */
    pointer-events: none;
  }

  .hero-panels {
    flex: 1;
    display: grid;
    align-items: center;
    width: min(44vw, 560px);
    margin-left: auto;
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) 1.5rem;
  }

  .hero-panel {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    visibility: hidden;
    transition: visibility 0s linear 0.4s;
  }

  .hero-panel[data-active] {
    visibility: visible;
    transition-delay: 0s;
  }

  .hero-panel a,
  .hero-index {
    pointer-events: auto;
  }

  /* Quem sai some subindo; quem entra vem de baixo, em cascata curta. */
  .hero-panel > * {
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .hero-panel[data-active] > * {
    opacity: 1;
    transform: none;
    animation: hero-in 0.8s var(--ease-out) both;
  }

  .hero-panel[data-active] > :nth-child(1) {
    animation-delay: 0.15s;
  }
  .hero-panel[data-active] > :nth-child(2) {
    animation-delay: 0.22s;
  }
  .hero-panel[data-active] > :nth-child(3) {
    animation-delay: 0.28s;
  }
  .hero-panel[data-active] > :nth-child(n + 4) {
    animation-delay: 0.34s;
  }

  /* Na carga inicial, a primeira mensagem já está no lugar (sem esperar a animação). */
  .hero:not(:global(.is-ready)) .hero-panel[data-active] > * {
    animation: none;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .hero-title {
    margin: 0;
    font-family: var(--f-display);
    font-size: clamp(2.1rem, 1rem + 2.6vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgb(14 13 34 / 0.45);
  }

  .hero-desc {
    max-width: 46ch;
    color: var(--c-on-dark-2);
    font-size: var(--t-lead);
    line-height: 1.6;
  }

  .hero-hl {
    max-width: 42ch;
    padding-left: 0.9rem;
    border-left: 2px solid var(--c-orange);
    font-weight: 600;
    line-height: 1.45;
  }

  .hero-kw {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--c-on-dark-3);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .only-m {
    display: none;
  }

  /* ——— Índice dos temas, na base da seção ——— */
  .hero-index {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding-bottom: clamp(1.25rem, 0.8rem + 1.2vw, 2rem);
  }

  .hero-tab {
    display: grid;
    gap: 0.85rem;
    padding: 0.6rem 0 0.25rem;
    border: 0;
    background: none;
    color: var(--c-on-dark-3);
    font-size: 0.95rem;
    font-weight: 600;
    text-align: left;
    transition: color var(--dur-2) var(--ease-out);
  }

  .hero-tab:hover {
    color: var(--c-on-dark-2);
  }

  .hero-tab[aria-selected='true'] {
    color: var(--c-on-dark);
  }

  .hero-tab:focus-visible {
    outline-color: var(--c-orange);
    outline-offset: 4px;
  }

  .tab-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  /* Losango da marca: acende no tema ativo. */
  .tab-label::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 1px;
    background: currentColor;
    opacity: 0.4;
    transform: rotate(45deg) scale(0.8);
    transition:
      background-color var(--dur-2) var(--ease-out),
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .hero-tab[aria-selected='true'] .tab-label::before {
    background: var(--c-orange);
    opacity: 1;
    transform: rotate(45deg) scale(1);
  }

  .tab-line {
    position: relative;
    height: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.2);
    overflow: hidden;
    transition: background-color var(--dur-2) var(--ease-out);
  }

  .hero-tab:hover .tab-line {
    background: rgb(255 255 255 / 0.35);
  }

  .tab-line i {
    position: absolute;
    inset: 0;
    background: var(--c-orange);
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero-tab[aria-selected='true'] .tab-line i {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.is-playing.tick) .hero-tab[aria-selected='true'] .tab-line i {
      animation: line 7s linear both;
    }
  }

  @keyframes line {
    from {
      transform: scaleX(0);
    }
  }

  /* ——— Profundidade ao rolar (CSS ligado ao scroll, sem JS) ———
     O fundo se desloca mais devagar que a página e o texto se despede subindo. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .media-item picture {
        animation: media-drift linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 100%;
      }

      .hero-panels {
        animation: copy-out linear both;
        animation-timeline: --hero;
        animation-range: exit 0% exit 70%;
      }
    }
  }

  @keyframes media-drift {
    to {
      transform: translateY(12%);
    }
  }

  @keyframes copy-out {
    to {
      opacity: 0;
      transform: translateY(-40px);
    }
  }

  /* ——— Tablet em paisagem e notebooks pequenos ——— */
  @media (min-width: 768px) and (max-width: 1179px) {
    .hero-panels {
      width: min(46vw, 520px);
    }

    .hero-desc {
      font-size: 1rem;
    }

    .hero-kw {
      display: none;
    }
  }

  /* ——— Celular e tablet em pé: banner vertical, texto no topo, arte embaixo ——— */
  @media (max-width: 767px), (max-width: 1023px) and (orientation: portrait) {
    .hero {
      /* Proporção natural do banner vertical (941 × 1671), limitada à altura útil da tela. */
      height: min(178vw, calc(100svh - var(--header-h) - 2.5rem));
      min-height: 560px;
    }

    /* A arte fica ancorada na base e a faixa de cima, onde o banner vertical traz o logotipo
       desenhado, sai do enquadramento: o título não disputa espaço com ele. */
    .media-item img {
      position: absolute;
      inset: auto 0 0;
      height: 111%;
      object-position: center bottom;
    }

    .media-item {
      pointer-events: none;
    }

    .hero-scrim {
      background:
        linear-gradient(180deg, rgb(14 13 34 / 0.75) 0%, rgb(14 13 34 / 0.45) 30%, transparent 55%),
        linear-gradient(0deg, rgb(14 13 34 / 0.85), transparent 20%);
    }

    .hero-panels {
      flex: none;
      align-items: start;
      width: 100%;
      margin-left: 0;
      padding-block: 1.75rem 1rem;
    }

    .hero-panel {
      gap: 0.8rem;
    }

    .hero-title {
      font-size: clamp(1.8rem, 1.1rem + 3.6vw, 2.6rem);
    }

    .hero-desc {
      font-size: 0.98rem;
    }

    .hero-hl {
      font-size: 0.92rem;
    }

    /* Deixa livre o canto do botão flutuante de WhatsApp. */
    .hero-index {
      margin-top: auto;
      gap: 0.9rem;
      padding-right: 64px;
    }

    .hero-tab {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 767px) {
    .only-d {
      display: none;
    }

    .only-m {
      display: block;
    }

    a.only-m {
      display: inline-flex;
    }
  }

  @media (max-width: 379px) {
    .tab-label::before {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-panel > *,
    .media-item,
    .hero-media {
      transition: none !important;
      animation: none !important;
    }

    .hero-panel > * {
      transform: none !important;
    }
  }
</style>
