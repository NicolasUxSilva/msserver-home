---
import Icon from './Icon.astro';
import { VIDEO } from '../config/site';

// Mesmo vídeo da home do WordPress (com a playlist do canal), em reprodução automática e sem som.
const params = new URLSearchParams({ list: VIDEO.playlist, mute: '1', playsinline: '1', rel: '0', cc_load_policy: '0' });
const embed = `https://www.youtube.com/embed/${VIDEO.id}?${params}`;
const watch = `https://www.youtube.com/watch?v=${VIDEO.id}&list=${VIDEO.playlist}`;
---

<section class="video on-dark" aria-label={VIDEO.title}>
  <div class="video-bg" aria-hidden="true"></div>
  <div class="container">
    <div class="frame" data-reveal data-video data-src={embed} data-title={VIDEO.title}>
      <a class="frame-fallback" href={watch} target="_blank" rel="noopener" data-video-fallback>
        <span class="play"><Icon name="play" size={28} /></span>
        <span class="sr-only">Assistir ao vídeo no YouTube</span>
      </a>
    </div>
  </div>
</section>

<script>
  // Carrega o player só quando a seção se aproxima da tela (como o "lazy load" do Elementor).
  // Com redução de movimento ativada, o vídeo não começa sozinho: o player aparece pausado.
  const frame = document.querySelector<HTMLElement>('[data-video]');
  if (frame) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const load = () => {
      const iframe = document.createElement('iframe');
      iframe.src = `${frame.dataset.src}&autoplay=${reduce ? 0 : 1}`;
      iframe.title = frame.dataset.title ?? 'Vídeo';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      iframe.addEventListener('load', () => frame.classList.add('is-loaded'), { once: true });
      frame.append(iframe);
    };
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          io.disconnect();
          load();
        }
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(frame);
  }
</script>

<style>
  .video {
    position: relative;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    background: var(--c-indigo-950);
    overflow: hidden;
    isolation: isolate;
  }

  .video-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 80% at 50% 120%, rgb(249 131 5 / 0.18), transparent 70%),
      radial-gradient(50% 60% at 90% 0%, rgb(61 58 134 / 0.55), transparent 70%);
  }

  .video-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.45;
    background-image:
      repeating-linear-gradient(30deg, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 34px),
      repeating-linear-gradient(150deg, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 34px);
    mask-image: radial-gradient(70% 80% at 50% 60%, #000, transparent);
    -webkit-mask-image: radial-gradient(70% 80% at 50% 60%, #000, transparent);
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    max-width: 1120px;
    margin-inline: auto;
    border: 1px solid var(--c-line-dark-2);
    border-radius: var(--r-xl);
    background: #000;
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.8);
    overflow: hidden;
  }

  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .frame:global(.is-loaded) :global(iframe) {
    opacity: 1;
  }

  .frame-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--c-on-dark);
  }

  .play {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--c-orange);
    color: #1a0f02;
  }

  @media (max-width: 639px) {
    .frame {
      border-radius: var(--r-lg);
    }
  }
</style>
