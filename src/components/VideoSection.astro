---
import Icon from './Icon.astro';
import { VIDEO } from '../config/site';

// Mesmo vídeo da home do WordPress (com a playlist do canal), em reprodução automática e sem som.
const params = new URLSearchParams({ list: VIDEO.playlist, mute: '1', playsinline: '1', rel: '0', cc_load_policy: '0' });
const embed = `https://www.youtube.com/embed/${VIDEO.id}?${params}`;
const watch = `https://www.youtube.com/watch?v=${VIDEO.id}&list=${VIDEO.playlist}`;
// Miniatura do próprio vídeo no YouTube, exibida enquanto o player carrega.
const poster = `https://i.ytimg.com/vi/${VIDEO.id}/maxresdefault.jpg`;
---

<section class="video" aria-label={VIDEO.title}>
  <div class="container">
    <div class="bezel" data-video-bezel>
      <div class="frame" data-video data-src={embed} data-title={VIDEO.title}>
        <img class="poster" src={poster} alt="" width="1280" height="720" loading="lazy" decoding="async" onerror="this.remove()" />
        <a class="frame-fallback" href={watch} target="_blank" rel="noopener" data-video-fallback>
          <span class="play"><Icon name="play" size={28} /></span>
          <span class="sr-only">Assistir ao vídeo no YouTube</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Carrega o player só quando a seção se aproxima da tela (como o "lazy load" do Elementor).
  // Com redução de movimento ativada, o vídeo não começa sozinho: o player aparece pausado.
  const frame = document.querySelector<HTMLElement>('[data-video]');
  if (frame) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const load = () => {
      const iframe = document.createElement('iframe');
      iframe.src = `${frame.dataset.src}&autoplay=${reduce ? 0 : 1}`;
      iframe.title = frame.dataset.title ?? 'Vídeo';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      iframe.addEventListener('load', () => frame.classList.add('is-loaded'), { once: true });
      frame.append(iframe);
    };
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          io.disconnect();
          load();
        }
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(frame);
  }
</script>

<style>
  /* O vídeo fecha o capítulo escuro e avança sobre a seção seguinte (ver .chapter em index). */
  .video {
    position: relative;
    padding-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    view-timeline: --video block;
  }

  /* Moldura em duas camadas: aro translúcido + tela, como um monitor sobre o fundo. */
  .bezel {
    position: relative;
    max-width: 1120px;
    margin-inline: auto;
    padding: clamp(6px, 0.4rem + 0.4vw, 12px);
    border: 1px solid var(--c-line-dark-2);
    border-radius: calc(var(--r-xl) + 8px);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.02));
    box-shadow:
      0 40px 70px -45px rgb(14 13 34 / 0.55),
      0 18px 36px -24px rgb(14 13 34 / 0.35);
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--r-xl);
    background: #05050f;
    overflow: hidden;
    isolation: isolate;
  }

  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity 0.6s var(--ease-out);
  }

  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    border: 0;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .frame:global(.is-loaded) :global(iframe) {
    opacity: 1;
  }

  .frame:global(.is-loaded) .poster {
    opacity: 0;
  }

  .frame-fallback {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    background: radial-gradient(closest-side, rgb(14 13 34 / 0.35), transparent);
    color: var(--c-on-dark);
  }

  .play {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    padding-left: 4px;
    border-radius: 50%;
    background: var(--c-orange);
    color: #1a0f02;
    box-shadow:
      0 0 0 10px rgb(249 131 5 / 0.18),
      0 18px 40px -12px rgb(0 0 0 / 0.6);
    transition: transform var(--dur-2) var(--ease-out), box-shadow var(--dur-2) var(--ease-out);
  }

  .frame-fallback:hover .play {
    transform: scale(1.06);
    box-shadow:
      0 0 0 14px rgb(249 131 5 / 0.22),
      0 18px 40px -12px rgb(0 0 0 / 0.6);
  }

  /* A moldura se aproxima conforme entra na tela (ligado ao scroll, sem JS). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bezel {
        animation: bezel-in linear both;
        animation-timeline: --video;
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes bezel-in {
    from {
      transform: translateY(40px) scale(0.92);
      opacity: 0.4;
    }
  }

  @media (max-width: 639px) {
    .bezel {
      border-radius: calc(var(--r-lg) + 6px);
    }

    .frame {
      border-radius: var(--r-lg);
    }

    .play {
      width: 60px;
      height: 60px;
    }
  }
</style>
