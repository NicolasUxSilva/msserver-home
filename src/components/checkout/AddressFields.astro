---
// Campos de endereço da finalização de compra (cobrança ou entrega), na ordem e com os nomes do
// WooCommerce (billing_*, shipping_*). Nome, obrigatoriedade e ordem mudam com o país no navegador
// (regras do WooCommerce para cada país, em src/scripts/checkout.ts).
import Icon from '../Icon.astro';
import { CHECKOUT as T, WC, countryOptions, pt } from '../../data/finalizar-compra';

interface Props {
  group: 'billing' | 'shipping';
  fields: (typeof WC.fields)[number][];
  hidden?: boolean;
}

const { group, fields, hidden = false } = Astro.props;
const HALF = new Set(['first_name', 'last_name', 'city', 'state', 'postcode', 'phone']);
const countries = countryOptions();
const id = (key: string) => `${group}_${key}`;
// Na entrega, o autocomplete leva "shipping" (o navegador não mistura com a cobrança). O WooCommerce usa
// "email username" no e-mail, combinação que o HTML não aceita: fica "email".
const auto = (token: string) => {
  const t = token.replace(/^email username$/, 'email');
  return group === 'shipping' ? `shipping ${t}` : t;
};
const placeholder = (key: string) => {
  const rule = (WC.locale.default as Record<string, { placeholder?: string }>)[key];
  return rule?.placeholder ? pt(rule.placeholder) : undefined;
};
---

<div class="co-fields" data-co-address={group} hidden={hidden}>
  {
    fields.map((f) => (
      <div class={`co-field${HALF.has(f.key) ? ' co-field--half' : ''}`} data-key={f.key} data-priority={f.priority} data-label={f.label}>
        <label class="co-label" for={id(f.key)}>
          <span data-co-label>{pt(f.label)}</span>
          <span class="co-req" aria-hidden="true" hidden={!f.required}>
            *
          </span>
          <span class="co-opt" hidden={f.required}>
            {T.optional}
          </span>
        </label>
        {f.key === 'country' ? (
          <div class="co-select">
            <select class="co-input" id={id(f.key)} name={id(f.key)} autocomplete={auto(f.autocomplete)} required aria-describedby={`${id(f.key)}-error`}>
              {countries.map((c) => (
                <option value={c.code} selected={c.code === WC.defaultCountry}>
                  {c.name}
                </option>
              ))}
            </select>
            <Icon name="chevron-down" size={18} />
          </div>
        ) : f.key === 'state' ? (
          <>
            <div class="co-select" data-co-state-select>
              <select class="co-input" id={id(f.key)} name={id(f.key)} autocomplete={auto(f.autocomplete)} aria-describedby={`${id(f.key)}-error`} />
              <Icon name="chevron-down" size={18} />
            </div>
            <input class="co-input" id={`${id(f.key)}_text`} type="text" autocomplete={auto(f.autocomplete)} hidden disabled aria-describedby={`${id(f.key)}-error`} data-co-state-text />
          </>
        ) : (
          <input
            class="co-input"
            id={id(f.key)}
            name={id(f.key)}
            type={f.type === 'email' ? 'email' : f.type === 'tel' ? 'tel' : 'text'}
            autocomplete={auto(f.autocomplete)}
            required={f.required}
            placeholder={placeholder(f.key)}
            inputmode={f.key === 'postcode' ? 'numeric' : undefined}
            spellcheck={f.type === 'email' || f.type === 'tel' ? 'false' : undefined}
            aria-describedby={`${id(f.key)}-error`}
          />
        )}
        <p class="co-error" id={`${id(f.key)}-error`} hidden>
          <Icon name="circle-alert" size={16} />
          <span data-co-error />
        </p>
      </div>
    ))
  }
</div>
