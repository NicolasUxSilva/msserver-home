# Carrega GTM, Google Ads, Meta Pixel, Clarity e RD Station (os mesmos da home no WordPress).
# Use true somente na publicação de produção.
PUBLIC_TRACKING=false
# true em ambientes de teste/preview para não indexar.
PUBLIC_NOINDEX=false

# Avaliações do Google na página "Sobre nós" (scripts/sync-google-reviews.mjs).
# Lidas só no build (Node), nunca enviadas ao navegador: não use o prefixo PUBLIC_.
# Chave de um projeto Google Cloud com a "Places API (New)" ativa, restrita a essa API.
GOOGLE_PLACES_API_KEY=
# Place ID do Perfil da Empresa da MSSERVER (Place ID Finder do Google).
GOOGLE_PLACE_ID=
