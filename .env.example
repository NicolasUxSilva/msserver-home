# Variáveis do site (docs/DEPLOY.md, seção 2). Copie para .env e ajuste. As que começam com PUBLIC_
# vão para o navegador; as demais ficam só no build.

# Inclui o aviso de cookies e as ferramentas de medição (GTM, Google Ads, Meta Pixel, Clarity e RD
# Station, as mesmas da home do WordPress). Cada ferramenta só carrega depois do consentimento da
# categoria dela. Use true SOMENTE no build de produção, com autorização (docs/TRACKING.md).
PUBLIC_TRACKING=false
# true em homologação e previews: noindex em todas as páginas e robots.txt com "Disallow: /".
PUBLIC_NOINDEX=false

# Store API do WooCommerce usada pelo carrinho, pela finalização e pelo "Orçamento" das páginas de
# produto. Vazio: o caminho no mesmo domínio (/wp-json/wc/store/v1), o único que funciona com a sessão
# do carrinho do WordPress. Fora de msserver.com.br o carrinho mostra que a loja está indisponível.
PUBLIC_STORE_API=

# Formulários (Orçamento e soluções): endpoint do WordPress que recebe o envio. Padrão:
# https://msserver.com.br/wp-admin/admin-ajax.php (o mesmo dos formulários do Elementor).
# Só funciona com a página servida no domínio msserver.com.br (mesma origem).
PUBLIC_QUOTE_ENDPOINT=

# Avaliações do Google na página "Sobre nós" (scripts/sync-google-reviews.mjs). Lidas só no build,
# nunca enviadas ao navegador: não use o prefixo PUBLIC_.
# Chave de um projeto Google Cloud com a "Places API (New)" ativa, restrita a essa API.
GOOGLE_PLACES_API_KEY=
# Place ID do Perfil da Empresa da MSSERVER (Place ID Finder do Google).
GOOGLE_PLACE_ID=

# De onde os scripts de sincronização leem os dados (padrão https://msserver.com.br). Use
# http://msserver.com.br enquanto o HTTPS estiver fora do ar.
WP_ORIGIN=

# Subcaminho do site (só para previews servidos fora da raiz). Em produção, vazio.
BASE_PATH=
