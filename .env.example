# Carrega GTM, Google Ads, Meta Pixel, Clarity e RD Station (os mesmos da home no WordPress).
# Use true somente na publicação de produção.
PUBLIC_TRACKING=false
# true em ambientes de teste/preview para não indexar.
PUBLIC_NOINDEX=false

# Avaliações do Google na página "Sobre nós" (scripts/sync-google-reviews.mjs).
# Lidas só no build (Node), nunca enviadas ao navegador: não use o prefixo PUBLIC_.
# Chave de um projeto Google Cloud com a "Places API (New)" ativa, restrita a essa API.
GOOGLE_PLACES_API_KEY=
# Place ID do Perfil da Empresa da MSSERVER (Place ID Finder do Google).
GOOGLE_PLACE_ID=

# Formulário de orçamento (/orcamento/): endpoint do WordPress que recebe o envio. Padrão:
# https://msserver.com.br/wp-admin/admin-ajax.php (o mesmo do formulário original do Elementor).
# Só funciona com a página servida no domínio msserver.com.br (mesma origem).
PUBLIC_QUOTE_ENDPOINT=

# Store API do WooCommerce usada pelo carrinho e pelo "Orçamento" das páginas de produto. Vazio: o
# caminho no mesmo domínio (/wp-json/wc/store/v1), que é o que funciona com a sessão do carrinho do
# WordPress. Fora de msserver.com.br o carrinho mostra que está indisponível.
PUBLIC_STORE_API=
