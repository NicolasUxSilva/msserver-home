{
  "name": "msserver-home",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Home institucional da MSSERVER com a identidade visual das landings",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node --env-file-if-exists=.env scripts/sync-google-reviews.mjs --optional",
    "build": "astro check && astro build && node scripts/routes.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:nginx": "node scripts/testar-nginx.mjs",
    "sync": "node scripts/sync-content.mjs",
    "sync:reviews": "node --env-file-if-exists=.env scripts/sync-google-reviews.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "sync:blog": "node scripts/sync-blog.mjs",
    "sync:servidores-fisicos": "node scripts/sync-servidores-fisicos.mjs",
    "build:suporte": "node scripts/package-suporte.mjs",
    "sync:all": "npm run sync && npm run sync:catalog && npm run sync:blog && npm run sync:servidores-fisicos && npm run sync:reviews --if-present",
    "validate:data": "node scripts/validate-data.mjs",
    "release": "npm run sync:all && node scripts/validate-data.mjs --online && npm run build && npm run test:unit && npm run test:e2e && npm run build:suporte"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "astro": "7.3.8",
    "lucide-static": "1.61.0",
    "sharp": "0.34.5",
    "simple-icons": "16.36.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
